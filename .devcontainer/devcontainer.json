{
  "name": "我的万能前端基地",
  // 💡 重点：我们这里不指定任何 image/Dockerfile。
  // 这样无论在云端还是本地，它都会默认直接继承官方最强大的 universal 基础环境，绝不额外占用你的任何空间。

  // 🛠️ 局部魔改：当你在云端 Codespaces 打开这个项目时，管家会自动帮你把下面这些提效神器一键安装好
  "customizations": {
    "vscode": {
      "settings": {
        // 让编辑器在保存代码时，自动帮我们格式化对齐 HTML/CSS 样式，再也不用手动调缩进了
        "editor.formatOnSave": true
      },
      "extensions": [
        "ms-vscode.live-preview",         // 1. 之前带你起飞的微软官方「Live Preview 实时预览」插件，每次开机直接预装好
        "esbenp.prettier-vscode",         // 2. 全球前端都在用的代码美化器 Prettier，让你的 Bootstrap 标签排版永远整洁
        "ecmel.vscode-html-css",          // 3. HTML 中智能提示 CSS 类名，写 Bootstrap 类名（如 col-md-6）时会有自动补全
        "PKief.material-icon-theme",       // 4. 超级好看的 Material 文件图标主题，让左侧的多库树状图拥有高颜值图标
        "GitHub.copilot"                  // 5. 官方 AI 编程助手，开机自动就位
      ]
    }
  },

  // 🚀 房子建好后，在终端自动打印一行欢迎语，顺便提示我们多库工作区已经准备就绪
  "postCreateCommand": "echo '======================================' && echo '🚀 欢迎回到云端基地！' && echo '📂 请在左侧直接双击 my-workspace.code-workspace 进入多库平级并列开发模式！' && echo '======================================'"
}
