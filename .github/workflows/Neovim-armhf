name: Build Neovim for armhf

on:
  workflow_dispatch:
    inputs:
      nvim_version:
        description: 'Neovim 版本分支或标签 (例如: stable, master, v0.12.6)'
        required: true
        default: 'stable'

jobs:
  build-armhf:
    runs-on: ubuntu-latest
    steps:
      - name: 设置 QEMU 模拟器以支持 armhf
        uses: docker/setup-qemu-action@v3
        with:
          platforms: arm/v7

      - name: 在 armhf 容器中拉取源码并编译
        run: |
          docker run --rm --platform linux/arm/v7 \
            -v "${{ github.workspace }}:/workspace" \
            debian:bookworm-slim \
            bash -c '
              set -e
              export DEBIAN_FRONTEND=noninteractive
              apt-get update && apt-get install -y --no-install-recommends \
                ca-certificates git ninja-build gettext cmake unzip curl build-essential

              git clone --depth 1 --branch "${{ github.event.inputs.nvim_version }}" \
                https://github.com /tmp/neovim

              cd /tmp/neovim
              make CMAKE_BUILD_TYPE=Release CMAKE_INSTALL_PREFIX=/tmp/nvim-armhf
              make install

              tar -czvf /workspace/nvim-linux-armhf.tar.gz -C /tmp/nvim-armhf .
            '

      - name: 上传编译产物 (Artifacts)
        uses: actions/upload-artifact@v4
        with:
          name: nvim-linux-armhf
          path: nvim-linux-armhf.tar.gz
